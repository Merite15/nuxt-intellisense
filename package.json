{
  "name": "nuxt-intellisense",
  "license": "MIT",
  "displayName": "Nuxt Intellisense",
  "description": "Enhanced IntelliSense for Nuxt3 projects",
  "version": "0.8.3",
  "publisher": "MeriteK",
  "changelog": "CHANGELOG.md",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "nuxt",
    "nuxt3",
    "vue",
    "codelens",
    "components",
    "composables",
    "plugins",
    "middleware",
    "pages",
    "layouts",
    "stores",
    "auto-import",
    "intellisense",
    "typescript",
    "javascript",
    "vue3",
    "vuejs",
    "vuejs3"
  ],
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Merite15/Nuxt-Intelliphense"
  },
  "activationEvents": [
    "workspaceContains:nuxt.config.js",
    "workspaceContains:nuxt.config.ts"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Nuxt Intellisense",
      "properties": {
        "nuxt-intellisense.showWelcomeMessage": {
          "type": "boolean",
          "default": true,
          "description": "Show welcome message when the extension is activated"
        },
        "nuxt-intellisense.showUnusedWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Report symbols with 0 detected references as hints in the Problems panel"
        },
        "nuxt-intellisense.ignoredDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "utils",
            "lib",
            "helpers",
            "constants",
            "shared",
            "public",
            "config",
            "assets"
          ],
          "description": "Directory names excluded from component/composable/store reference search (in addition to node_modules, .nuxt, .output and dist, which are always excluded)"
        }
      }
    },
    "commands": [
      {
        "command": "nuxt-intellisense.refreshCodeLens",
        "title": "Refresh Nuxt CodeLens"
      },
      {
        "command": "nuxt-intellisense.showDocumentation",
        "title": "Show Nuxt Intellisense Documentation"
      },
      {
        "command": "nuxt-intellisense.refreshExplorer",
        "title": "Refresh Nuxt Explorer",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "nuxtIntellisenseExplorer",
          "name": "Nuxt Structure",
          "icon": "images/logo.png",
          "contextualTitle": "Nuxt Intellisense",
          "when": "nuxtIntellisense.isNuxtProject"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "nuxt-intellisense.refreshExplorer",
          "when": "view == nuxtIntellisenseExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "mocha --require ./src/test/mocha.setup.js --timeout 10000 \"out/test/unit/**/*.test.js\" \"out/test/integration/**/*.test.js\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.60.0",
    "@vscode/test-electron": "^2.1.5",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.6",
    "typescript": "^5.8.3"
  }
}